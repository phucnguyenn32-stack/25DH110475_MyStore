@model _25DH110475_MyStore.Models.Category

@{
    ViewBag.Title = "Xóa danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .category-delete-page {
        max-width: 850px;
        margin: 0 auto;
    }

    .category-delete-heading {
        margin-bottom: 22px;
    }

        .category-delete-heading h2 {
            color: #b42318;
            font-weight: 700;
        }

        .category-delete-heading p {
            color: #7b8794;
        }

    .category-delete-card {
        background: #fff;
        border: 1px solid #f0d5d3;
        border-radius: 12px;
        padding: 28px;
    }

    .category-delete-warning {
        background: #fff4f2;
        border: 1px solid #f5c2bd;
        color: #a1261d;
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 24px;
    }

    .category-delete-icon {
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff0ee;
        color: #c0392b;
        border-radius: 12px;
        font-size: 28px;
        margin-bottom: 22px;
    }

    .category-delete-row {
        padding: 16px 0;
        border-bottom: 1px solid #edf0f4;
    }

    .category-delete-label {
        display: block;
        color: #7b8794;
        font-size: 13px;
        margin-bottom: 7px;
    }

    .category-delete-value {
        color: #263445;
        font-size: 16px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .category-delete-id {
        display: inline-block;
        padding: 7px 12px;
        background: #f1f5f9;
        color: #536273;
        border-radius: 6px;
    }

    .category-delete-actions {
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #edf0f4;
    }

        .category-delete-actions .btn {
            margin: 3px 5px 3px 0;
        }

    @@media (max-width: 767px) {
        .category-delete-card {
            padding: 18px;
        }
    }
</style>

<div class="category-delete-page">
    <div class="category-delete-heading">
        <h2>Xóa danh mục</h2>
        <p>Xác nhận trước khi xóa danh mục khỏi hệ thống.</p>
    </div>

    <div class="category-delete-card">
        <div class="category-delete-warning">
            <strong>
                <span class="glyphicon glyphicon-warning-sign"></span>
                Cảnh báo!
            </strong>
            <p style="margin: 8px 0 0;">
                Bạn có chắc chắn muốn xóa danh mục này không?
                Nếu danh mục đang chứa sản phẩm, hệ thống sẽ không cho phép xóa.
            </p>
        </div>

        <div class="category-delete-icon">
            <span class="glyphicon glyphicon-folder-open"></span>
        </div>

        <div class="category-delete-row">
            <span class="category-delete-label">Mã danh mục</span>
            <div class="category-delete-value">
                <span class="category-delete-id">#@Model.CategoryID</span>
            </div>
        </div>

        <div class="category-delete-row">
            <span class="category-delete-label">Tên danh mục</span>
            <div class="category-delete-value">
                @Model.CategoryName
            </div>
        </div>

        <div class="category-delete-actions">
            @using (Html.BeginForm(
                "Delete",
                "Categories",
                new { id = Model.CategoryID },
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger"
                        onclick="return confirm('Bạn có chắc chắn muốn xóa danh mục này không?');">
                    <span class="glyphicon glyphicon-trash"></span>
                    Xác nhận xóa
                </button>

                @Html.ActionLink(
                    "Hủy, quay lại danh sách",
                    "Index",
                    null,
                    new { @class = "btn btn-default" })
            }
        </div>
    </div>
</div>