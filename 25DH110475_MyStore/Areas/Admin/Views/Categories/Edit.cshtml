@model _25DH110475_MyStore.Models.Category

@{
    ViewBag.Title = "Chỉnh sửa danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .category-edit-page {
        max-width: 850px;
        margin: 0 auto;
    }

    .category-edit-heading {
        margin-bottom: 22px;
    }

        .category-edit-heading h2 {
            color: #263445;
            font-weight: 700;
        }

        .category-edit-heading p {
            color: #7b8794;
        }

    .category-edit-card {
        background: #fff;
        border: 1px solid #e4e9ef;
        border-radius: 12px;
        padding: 28px;
    }

        .category-edit-card .control-label {
            color: #344256;
            font-weight: 600;
        }

        .category-edit-card .form-control {
            min-height: 40px;
            border-radius: 6px;
        }

    .category-edit-id {
        display: inline-block;
        padding: 9px 12px;
        background: #f1f5f9;
        border-radius: 6px;
        color: #536273;
        font-weight: 600;
    }

    .category-edit-note {
        color: #7b8794;
        font-size: 12px;
        margin-top: 7px;
    }

    .category-edit-actions {
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #edf0f4;
    }

    @@media (max-width: 767px) {
        .category-edit-card {
            padding: 18px;
        }
    }
</style>

<div class="category-edit-page">
    <div class="category-edit-heading">
        <h2>Chỉnh sửa danh mục</h2>
        <p>Cập nhật tên danh mục trong cửa hàng.</p>
    </div>

    <div class="category-edit-card">
        @using (Html.BeginForm("Edit", "Categories", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.CategoryID)
            @Html.ValidationSummary(false, "", new { @class = "text-danger" })

            <div class="form-horizontal">
                <div class="form-group">
                    <label class="control-label col-md-3">Mã danh mục</label>
                    <div class="col-md-9">
                        <div class="category-edit-id">
                            #@Model.CategoryID
                        </div>
                        <p class="category-edit-note">
                            Mã danh mục được hệ thống quản lý tự động.
                        </p>
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(
                        model => model.CategoryName,
                        "Tên danh mục",
                        new { @class = "control-label col-md-3" })

                    <div class="col-md-9">
                        @Html.TextBoxFor(
                            model => model.CategoryName,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Nhập tên danh mục...",
                                maxlength = "100"
                            })

                        @Html.ValidationMessageFor(
                            model => model.CategoryName,
                            "",
                            new { @class = "text-danger" })

                        <p class="category-edit-note">
                            Tên danh mục không được để trống hoặc trùng với danh mục khác.
                        </p>
                    </div>
                </div>

                <div class="category-edit-actions">
                    <div class="col-md-offset-3 col-md-9">
                        <button type="submit" class="btn btn-success">
                            Lưu thay đổi
                        </button>

                        @Html.ActionLink(
                            "Hủy",
                            "Index",
                            null,
                            new { @class = "btn btn-default" })
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}