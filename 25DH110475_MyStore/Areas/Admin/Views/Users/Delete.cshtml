@model _25DH110475_MyStore.Models.User

@{
    ViewBag.Title = "Xóa tài khoản";
}

<h2>Xóa tài khoản</h2>

<h4>Bạn có chắc chắn muốn xóa tài khoản này không?</h4>
<hr />

<dl class="dl-horizontal">
    <dt>Username</dt>
    <dd>@Model.Username</dd>

    <dt>Quyền tài khoản</dt>
    <dd>@Model.UserRole</dd>
</dl>

@using (Html.BeginForm("Delete", "Users", new { id = Model.Username }, FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <input type="submit" value="Xác nhận xóa" class="btn btn-danger" />
    @Html.ActionLink("Hủy", "Index", null, new { @class = "btn btn-default" })
}