@model _25DH110475_MyStore.Models.User

@{
    ViewBag.Title = "Sửa tài khoản";
}

<h2>Sửa tài khoản</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.Hidden("id", Model.Username)

    <div class="form-horizontal">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(m => m.Username, "Username", new { @class = "control-label col-md-2" })
            <div class="col-md-5">
                <p class="form-control-static">@Model.Username</p>
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Password, "Mật khẩu mới", new { @class = "control-label col-md-2" })
            <div class="col-md-5">
                @Html.Password("Password", Model.Password, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.UserRole, "Quyền tài khoản", new { @class = "control-label col-md-2" })
            <div class="col-md-5">
                @Html.TextBox("UserRole", Model.UserRole, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.UserRole, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-5">
                <input type="submit" value="Lưu thay đổi" class="btn btn-primary" />
                @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-default" })
            </div>
        </div>
    </div>
}