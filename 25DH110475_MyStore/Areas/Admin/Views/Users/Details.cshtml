@model _25DH110475_MyStore.Models.User

@{
    ViewBag.Title = "Chi tiết tài khoản";
}

<h2>Chi tiết tài khoản</h2>

<hr />

<dl class="dl-horizontal">
    <dt>Username</dt>
    <dd>@Model.Username</dd>

    <dt>Quyền tài khoản</dt>
    <dd>@Model.UserRole</dd>
</dl>

<p>
    @Html.ActionLink("Sửa", "Edit", new { id = Model.Username }, new { @class = "btn btn-warning" })
    @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-default" })
</p>