@model PagedList.IPagedList<_25DH110475_MyStore.Models.User>
@using PagedList.Mvc

@{
    ViewBag.Title = "Quản lý tài khoản";
}

<h2>Quản lý tài khoản</h2>

<div class="row" style="margin-bottom: 15px;">
    <div class="col-md-8">
        @using (Html.BeginForm("Index", "Users", FormMethod.Get))
        {
            <div class="input-group">
                @Html.TextBox("searchString", ViewBag.SearchString as string,
                    new { @class = "form-control", placeholder = "Tìm username hoặc quyền..." })

                <span class="input-group-btn">
                    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
                    @Html.ActionLink("Làm mới", "Index", null,
                        new { @class = "btn btn-default" })
                </span>
            </div>
        }
    </div>

    <div class="col-md-4 text-right">
        @Html.ActionLink(" + Thêm tài khoản", "Create", null,
            new { @class = "btn btn-success" })
    </div>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>
                @Html.ActionLink("Username", "Index",
                    new { sortOrder = ViewBag.UsernameSort, searchString = ViewBag.SearchString })
            </th>
            <th>
                @Html.ActionLink("Quyền tài khoản", "Index",
                    new { sortOrder = ViewBag.RoleSort, searchString = ViewBag.SearchString })
            </th>
            <th style="width: 230px;">Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Username)</td>
                    <td>@Html.DisplayFor(modelItem => item.UserRole)</td>
                    <td>
                        @Html.ActionLink("Chi tiết", "Details",
                            new { id = item.Username }, new { @class = "btn btn-info btn-sm" })
                        @Html.ActionLink("Sửa", "Edit",
                            new { id = item.Username }, new { @class = "btn btn-warning btn-sm" })
                        @Html.ActionLink("Xóa", "Delete",
                            new { id = item.Username }, new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="3" class="text-center">Không tìm thấy tài khoản.</td>
            </tr>
        }
    </tbody>
</table>

<div class="text-center">
    @Html.PagedListPager(Model, page => Url.Action("Index", new
    {
        page,
        searchString = ViewBag.SearchString,
        sortOrder = ViewBag.CurrentSort
    }))
</div>

<p>
    Trang @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber)
    / @Model.PageCount
</p>