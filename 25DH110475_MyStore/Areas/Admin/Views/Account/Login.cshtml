@{
    ViewBag.Title = "Đăng nhập Admin";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập Admin | MyStore</title>

    @Styles.Render("~/Content/css")

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            font-family: "Segoe UI", Arial, sans-serif;
            background: linear-gradient(135deg, #18263a, #28527a);
        }

        .login-wrapper {
            width: 100%;
            max-width: 420px;
        }

        .brand {
            text-align: center;
            color: #fff;
            margin-bottom: 25px;
        }

        .brand-name {
            font-size: 30px;
            font-weight: 800;
            letter-spacing: 3px;
            margin-bottom: 8px;
        }

            .brand-name span {
                color: #70c4ff;
            }

        .brand-subtitle {
            color: #d1deec;
            font-size: 14px;
        }

        .login-card {
            background: #fff;
            padding: 35px;
            border-radius: 14px;
            box-shadow: 0 18px 50px rgba(0, 0, 0, 0.22);
        }

            .login-card h2 {
                text-align: center;
                font-size: 24px;
                color: #24364b;
                font-weight: 700;
                margin: 0 0 8px;
            }

        .login-description {
            text-align: center;
            color: #7b8794;
            font-size: 13px;
            margin-bottom: 28px;
        }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                color: #344256;
                font-size: 14px;
                font-weight: 600;
                margin-bottom: 8px;
            }

        .form-control {
            height: 46px;
            border: 1px solid #d9e0e8;
            border-radius: 7px;
            box-shadow: none;
            padding: 10px 13px;
        }

            .form-control:focus {
                border-color: #3987d7;
                box-shadow: 0 0 0 3px rgba(57, 135, 215, 0.12);
            }

        .btn-login {
            display: block;
            width: 100%;
            height: 46px;
            margin-top: 8px;
            border: none;
            border-radius: 7px;
            background: #2878c7;
            color: #fff;
            font-size: 15px;
            font-weight: 700;
            transition: background 0.2s;
        }

            .btn-login:hover {
                background: #1d609f;
            }

        .login-error {
            padding: 11px 13px;
            margin: 0 0 20px;
            color: #a4262c;
            background: #fff0f0;
            border: 1px solid #ffd4d4;
            border-radius: 7px;
            font-size: 13px;
        }

        .login-footer {
            color: #d1deec;
            text-align: center;
            font-size: 12px;
            margin-top: 22px;
        }
    </style>
</head>

<body>
    <div class="login-wrapper">
        <div class="brand">
            <div class="brand-name">MY<span>STORE</span></div>
            <div class="brand-subtitle">Hệ thống quản trị cửa hàng</div>
        </div>

        <div class="login-card">
            <h2>Đăng nhập Admin</h2>
            <p class="login-description">
                Đăng nhập để truy cập trang quản trị
            </p>

            @using (Html.BeginForm("Login", "Account",
                new { area = "Admin" }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                if (ViewBag.Error != null)
                {
                    <div class="login-error" role="alert">
                        @ViewBag.Error
                    </div>
                }

                <div class="form-group">
                    <label for="username">Tên đăng nhập</label>
                    <input type="text"
                           id="username"
                           name="username"
                           class="form-control"
                           placeholder="Nhập tên đăng nhập"
                           autocomplete="username"
                           required
                           autofocus />
                </div>

                <div class="form-group">
                    <label for="password">Mật khẩu</label>
                    <input type="password"
                           id="password"
                           name="password"
                           class="form-control"
                           placeholder="Nhập mật khẩu"
                           autocomplete="current-password"
                           required />
                </div>

                <button type="submit" class="btn-login">
                    ĐĂNG NHẬP
                </button>
            }
        </div>

        <div class="login-footer">
            &copy; @DateTime.Now.Year MyStore Admin
        </div>
    </div>
</body>
</html>