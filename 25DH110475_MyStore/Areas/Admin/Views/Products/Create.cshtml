@model _25DH110475_MyStore.Models.Product

@{
    ViewBag.Title = "Thêm sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .create-product-page {
        max-width: 900px;
        margin: 0 auto;
    }

    .create-product-heading {
        margin-bottom: 22px;
    }

        .create-product-heading h2 {
            color: #263445;
            font-weight: 700;
        }

    .create-product-card {
        background: #fff;
        border: 1px solid #e4e9ef;
        border-radius: 12px;
        padding: 28px;
    }

        .create-product-card .control-label {
            color: #344256;
            font-weight: 600;
        }

        .create-product-card .form-control {
            border-radius: 6px;
            min-height: 40px;
        }

    .upload-box {
        border: 2px dashed #cbd5e1;
        background: #f8fafc;
        border-radius: 9px;
        padding: 20px;
    }

    .upload-note {
        display: block;
        color: #7b8794;
        font-size: 12px;
        margin-top: 8px;
    }

    .create-product-actions {
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #edf0f4;
    }
</style>

<div class="create-product-page">
    <div class="create-product-heading">
        <h2>Thêm sản phẩm mới</h2>
        <p>Nhập thông tin và tải ảnh sản phẩm lên cửa hàng.</p>
    </div>

    <div class="create-product-card">
        @using (Html.BeginForm("Create", "Products", FormMethod.Post,
            new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(false, "",
                new { @class = "text-danger" })

            <div class="form-horizontal">

                <div class="form-group">
                    @Html.LabelFor(model => model.CategoryID, "Danh mục",
                        new { @class = "control-label col-md-3" })

                    <div class="col-md-9">
                        @Html.DropDownList("CategoryID", null,
                            "-- Chọn danh mục --",
                            new { @class = "form-control" })

                        @Html.ValidationMessageFor(model => model.CategoryID,
                            "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.ProductName, "Tên sản phẩm",
                        new { @class = "control-label col-md-3" })

                    <div class="col-md-9">
                        @Html.TextBoxFor(model => model.ProductName,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Nhập tên sản phẩm..."
                            })

                        @Html.ValidationMessageFor(model => model.ProductName,
                            "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.ProductDecription, "Mô tả",
                        new { @class = "control-label col-md-3" })

                    <div class="col-md-9">
                        @Html.TextAreaFor(model => model.ProductDecription,
                            new
                            {
                                @class = "form-control",
                                rows = "4",
                                placeholder = "Nhập mô tả sản phẩm..."
                            })

                        @Html.ValidationMessageFor(model => model.ProductDecription,
                            "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(model => model.ProductPrice, "Giá sản phẩm",
                        new { @class = "control-label col-md-3" })

                    <div class="col-md-9">
                        @Html.TextBoxFor(model => model.ProductPrice,
                            new
                            {
                                @class = "form-control",
                                type = "number",
                                min = "0",
                                step = "any",
                                placeholder = "Nhập giá sản phẩm"
                            })

                        @Html.ValidationMessageFor(model => model.ProductPrice,
                            "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <label class="control-label col-md-3" for="UploadImg">
                        Ảnh sản phẩm
                    </label>

                    <div class="col-md-9">
                        <div class="upload-box">
                            <input type="file"
                                   id="UploadImg"
                                   name="UploadImg"
                                   accept=".jpg,.jpeg,.png,.gif,.webp"
                                   required="required" />

                            <span class="upload-note">
                                Bắt buộc chọn ảnh JPG, JPEG, PNG, GIF hoặc WEBP.
                            </span>

                            @Html.ValidationMessageFor(model => model.UploadImg,
                                "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="create-product-actions">
                    <div class="col-md-offset-3 col-md-9">
                        <button type="submit" class="btn btn-success">
                            Thêm sản phẩm
                        </button>

                        @Html.ActionLink("Quay lại danh sách", "Index", null,
                            new { @class = "btn btn-default" })
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}