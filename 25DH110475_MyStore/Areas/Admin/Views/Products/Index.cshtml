@using PagedList.Mvc
@model _25DH110475_MyStore.Models.ViewModel.SearchProductVM

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>
@using (Html.BeginForm("Index", "Products", FormMethod.Get))
{
    <div class="form-group">

        @Html.TextBox("searchString", Model.SearchString, new
        {
            @class = "form-control",
            placeholder = "Nhập tên sản phẩm..."
        })

        <br />

        @Html.TextBox("minPrice", Model.MinPrice, new
        {
            @class = "form-control",
            placeholder = "Giá từ"
        })

        <br />

        @Html.TextBox("maxPrice", Model.MaxPrice, new
        {
            @class = "form-control",
            placeholder = "Giá đến"
        })

        <br />

        <input type="submit" value="Tìm kiếm" class="btn btn-primary" />
    </div>
}
<div class="form-group">
    <strong>Sắp xếp:</strong>

    @Html.ActionLink("Tên A → Z", "Index",
        new
        {
            searchString = Model.SearchString,
            minPrice = Model.MinPrice,
            maxPrice = Model.MaxPrice,
            sortOrder = "name_asc"
        },
        new { @class = "btn btn-default" })

    @Html.ActionLink("Tên Z → A", "Index",
        new
        {
            searchString = Model.SearchString,
            minPrice = Model.MinPrice,
            maxPrice = Model.MaxPrice,
            sortOrder = "name_desc"
        },
        new { @class = "btn btn-default" })

    @Html.ActionLink("Giá thấp → cao", "Index",
        new
        {
            searchString = Model.SearchString,
            minPrice = Model.MinPrice,
            maxPrice = Model.MaxPrice,
            sortOrder = "price_asc"
        },
        new { @class = "btn btn-default" })

    @Html.ActionLink("Giá cao → thấp", "Index",
        new
        {
            searchString = Model.SearchString,
            minPrice = Model.MinPrice,
            maxPrice = Model.MaxPrice,
            sortOrder = "price_desc"
        },
        new { @class = "btn btn-default" })
</div>
<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            Tên sản phẩm
        </th>
        <th>
            Mô tả
        </th>
        <th>
            Giá
        </th>
        <th>
            Hình ảnh
        </th>
        <th>
            Danh mục
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model.Products)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ProductName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductDecription)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductPrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductImage)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Category.CategoryName)
            </td>
            <td>
                @Html.ActionLink("Edit", "Edit", new { id = item.ProductID }) |
                @Html.ActionLink("Details", "Details", new { id = item.ProductID }) |
                @Html.ActionLink("Delete", "Delete", new { id = item.ProductID })
            </td>
        </tr>
    }

</table>
<br />

<div>
    @Html.PagedListPager(
        Model.Products,
        page => Url.Action("Index", new
        {
            page,
            searchString = Model.SearchString,
            minPrice = Model.MinPrice,
            maxPrice = Model.MaxPrice
        })
    )
</div>
