@model _25DH110475_MyStore.Models.Product

@{
    ViewBag.Title = "Xóa sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .delete-product-page {
        max-width: 850px;
        margin: 0 auto;
    }

    .delete-heading {
        margin-bottom: 22px;
    }

        .delete-heading h2 {
            color: #b42318;
            font-weight: 700;
        }

    .delete-card {
        background: #fff;
        border: 1px solid #f0d5d3;
        border-radius: 12px;
        padding: 28px;
    }

    .delete-warning {
        background: #fff4f2;
        border: 1px solid #f5c2bd;
        color: #a1261d;
        border-radius: 8px;
        padding: 14px 16px;
        margin-bottom: 24px;
    }

    .delete-product-image {
        max-width: 100%;
        max-height: 240px;
        object-fit: contain;
        border: 1px solid #e4e9ef;
        border-radius: 8px;
        padding: 6px;
        background: #fff;
    }

    .delete-image-box {
        background: #f8fafc;
        border-radius: 9px;
        padding: 18px;
        text-align: center;
    }

    .delete-info h3 {
        margin-top: 0;
        color: #263445;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .delete-info-row {
        padding: 12px 0;
        border-bottom: 1px solid #edf0f4;
    }

    .delete-label {
        color: #7b8794;
        font-size: 13px;
        margin-bottom: 4px;
    }

    .delete-value {
        color: #344256;
        overflow-wrap: anywhere;
    }

    .delete-price {
        color: #168253;
        font-size: 22px;
        font-weight: 700;
    }

    .delete-actions {
        border-top: 1px solid #edf0f4;
        margin-top: 24px;
        padding-top: 20px;
    }

    @@media (max-width: 767px) {
        .delete-card {
            padding: 16px;
        }

        .delete-info {
            margin-top: 22px;
        }
    }
</style>

<div class="delete-product-page">
    <div class="delete-heading">
        <h2>Xóa sản phẩm</h2>
        <p>Xác nhận trước khi xóa sản phẩm khỏi cửa hàng.</p>
    </div>

    <div class="delete-card">
        <div class="delete-warning">
            <strong>Chú ý!</strong>
            Bạn có chắc chắn muốn xóa sản phẩm này không?
            Thao tác này có thể không khôi phục được.
        </div>

        <div class="row">
            <div class="col-md-5">
                <div class="delete-image-box">
                    @if (!string.IsNullOrEmpty(Model.ProductImage))
                    {
                        <img src="@Url.Content(Model.ProductImage)"
                             alt="@Model.ProductName"
                             class="delete-product-image" />
                    }
                    else
                    {
                        <p class="text-muted">Sản phẩm chưa có ảnh.</p>
                    }
                </div>
            </div>

            <div class="col-md-7 delete-info">
                <h3>@Model.ProductName</h3>

                <div class="delete-info-row">
                    <div class="delete-label">Mã sản phẩm</div>
                    <div class="delete-value">@Model.ProductID</div>
                </div>

                <div class="delete-info-row">
                    <div class="delete-label">Danh mục</div>
                    <div class="delete-value">
                        @(Model.Category != null
                            ? Model.Category.CategoryName
                            : "Chưa phân loại")
                    </div>
                </div>

                <div class="delete-info-row">
                    <div class="delete-label">Giá bán</div>
                    <div class="delete-price">
                        @string.Format("{0:N0}", Model.ProductPrice)
                    </div>
                </div>

                <div class="delete-info-row">
                    <div class="delete-label">Mô tả</div>
                    <div class="delete-value">
                        @(string.IsNullOrWhiteSpace(Model.ProductDecription)
                            ? "Chưa có mô tả."
                            : Model.ProductDecription)
                    </div>
                </div>
            </div>
        </div>

        <div class="delete-actions">
            @using (Html.BeginForm("Delete", "Products",
                new { id = Model.ProductID }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger"
                        onclick="return confirm('Sư phụ xác nhận xóa sản phẩm này chứ?');">
                    Xác nhận xóa
                </button>

                @Html.ActionLink("Hủy, quay lại danh sách", "Index", null,
                    new { @class = "btn btn-default" })
            }
        </div>
    </div>
</div>