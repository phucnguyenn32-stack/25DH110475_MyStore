@model _25DH110475_MyStore.Models.Order

@{
    ViewBag.Title = "Xóa đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid" style="padding: 25px;">
    <div style="margin-bottom: 25px;">
        <h2 style="font-weight: 700; color: #2c3e50;">
            <i class="glyphicon glyphicon-trash"></i> Xóa đơn hàng
        </h2>
        <p style="color: #7f8c8d;">
            Kiểm tra thông tin trước khi xác nhận xóa đơn hàng.
        </p>
    </div>

    <div class="panel panel-danger" style="border-radius: 8px; overflow: hidden;">
        <div class="panel-heading" style="padding: 15px;">
            <h4 style="margin: 0; font-weight: 600;">
                <i class="glyphicon glyphicon-warning-sign"></i>
                Xác nhận xóa đơn hàng #@Model.OrderID
            </h4>
        </div>

        <div class="panel-body" style="padding: 25px;">
            <div class="alert alert-warning">
                <strong>Lưu ý!</strong>
                Thao tác này sẽ xóa đơn hàng khỏi hệ thống và có thể không khôi phục được.
            </div>

            <dl class="dl-horizontal" style="line-height: 2.2; margin-bottom: 25px;">
                <dt>Mã đơn hàng</dt>
                <dd>#@Model.OrderID</dd>

                <dt>Khách hàng</dt>
                <dd>
                    @(Model.Customer != null
                        ? Model.Customer.CustomerName
                        : "Chưa có thông tin khách hàng")
                </dd>

                <dt>Ngày đặt hàng</dt>
                <dd>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt>Tổng tiền</dt>
                <dd style="color: #c0392b; font-weight: 700;">
                    @Model.TotalAmount.ToString("N0") đ
                </dd>

                <dt>Trạng thái thanh toán</dt>
                <dd>@Model.PaymentStatus</dd>

                <dt>Địa chỉ giao hàng</dt>
                <dd>@Model.AddressDelivery</dd>
            </dl>

            @using (Html.BeginForm("Delete", "Orders", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.OrderID)

                <div style="border-top: 1px solid #eee; padding-top: 20px;">
                    <button type="submit" class="btn btn-danger"
                            onclick="return confirm('Sư phụ có chắc chắn muốn xóa đơn hàng này không?');">
                        <i class="glyphicon glyphicon-trash"></i>
                        Xác nhận xóa
                    </button>

                    @Html.ActionLink(
                        "Quay lại danh sách",
                        "Index",
                        null,
                        new { @class = "btn btn-default", style = "margin-left: 8px;" }
                    )

                    @Html.ActionLink(
                        "Xem chi tiết",
                        "Details",
                        new { id = Model.OrderID },
                        new { @class = "btn btn-info", style = "margin-left: 8px;" }
                    )
                </div>
            }
        </div>
    </div>
</div>