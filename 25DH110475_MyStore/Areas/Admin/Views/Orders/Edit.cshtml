@model _25DH110475_MyStore.Models.Order

@{
    ViewBag.Title = "Chỉnh sửa đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .order-edit-page {
        max-width: 900px;
        margin: 0 auto;
    }

    .order-edit-heading {
        margin-bottom: 24px;
    }

        .order-edit-heading h2 {
            color: #263445;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .order-edit-heading p {
            color: #7b8794;
            margin: 0;
        }

    .order-edit-card {
        background: #fff;
        border: 1px solid #e4e9ef;
        border-radius: 12px;
        overflow: hidden;
    }

    .order-edit-card-header {
        padding: 18px 22px;
        background: #f8fafc;
        border-bottom: 1px solid #e4e9ef;
        color: #263445;
        font-weight: 700;
    }

    .order-edit-body {
        padding: 25px;
    }

        .order-edit-body .control-label {
            color: #536273;
            font-weight: 600;
            text-align: left;
            padding-top: 10px;
        }

        .order-edit-body .form-control {
            min-height: 40px;
            border-radius: 6px;
            box-shadow: none;
        }

        .order-edit-body textarea.form-control {
            min-height: 100px;
            resize: vertical;
        }

        .order-edit-body .form-group {
            margin-bottom: 22px;
        }

    .order-edit-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding-top: 8px;
    }

        .order-edit-actions .btn {
            border-radius: 6px;
            padding: 9px 16px;
        }

    .order-edit-note {
        color: #7b8794;
        font-size: 13px;
        margin-top: 5px;
    }

    @@media (max-width: 767px) {
        .order-edit-body {
            padding: 18px;
        }

            .order-edit-body .control-label {
                padding-top: 0;
                margin-bottom: 8px;
            }
    }
</style>

<div class="order-edit-page">
    <div class="order-edit-heading">
        <h2>Chỉnh sửa đơn hàng #@Model.OrderID</h2>
        <p>Cập nhật thông tin khách hàng, thanh toán và giao hàng.</p>
    </div>

    <div class="order-edit-card">
        <div class="order-edit-card-header">
            Thông tin đơn hàng
        </div>

        <div class="order-edit-body">
            @using (Html.BeginForm("Edit", "Orders", FormMethod.Post,
                new { @class = "form-horizontal" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.OrderID)

                @Html.ValidationSummary(
                    true,
                    "",
                    new { @class = "text-danger" })

                <div class="form-group">
                    @Html.LabelFor(
                        model => model.CustomerID,
                        "Khách hàng",
                        new { @class = "control-label col-md-3" })

                    <div class="col-md-9">
                        @Html.DropDownList(
                            "CustomerID",
                            null,
                            "-- Chọn khách hàng --",
                            new { @class = "form-control" })

                        @Html.ValidationMessageFor(
                            model => model.CustomerID,
                            "",
                            new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(
                        model => model.OrderDate,
                        "Ngày đặt hàng",
                        new { @class = "control-label col-md-3" })

                    <div class="col-md-9">
                        @Html.TextBoxFor(
                            model => model.OrderDate,
                            "{0:yyyy-MM-ddTHH:mm}",
                            new
                                 {
                                @class = "form-control",
                                type = "datetime-local"
                            })

                        @Html.ValidationMessageFor(
                            model => model.OrderDate,
                            "",
                            new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(
                        model => model.TotalAmount,
                        "Tổng tiền (VNĐ)",
                        new { @class = "control-label col-md-3" })

                    <div class="col-md-9">
                        @Html.TextBoxFor(
                            model => model.TotalAmount,
                            new
                                 {
                                @class = "form-control",
                                type = "number",
                                min = "0",
                                step = "1000"
                            })

                        @Html.ValidationMessageFor(
                            model => model.TotalAmount,
                            "",
                            new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(
                        model => model.PaymentStatus,
                        "Trạng thái thanh toán",
                        new { @class = "control-label col-md-3" })

                    <div class="col-md-9">
                        @Html.DropDownListFor(
                            model => model.PaymentStatus,
                            new SelectList(new[] {
                                new SelectListItem {
                                    Text = "Chưa thanh toán",
                                    Value = "Chưa thanh toán"
                                },
                                new SelectListItem {
                                    Text = "Đã thanh toán",
                                    Value = "Đã thanh toán"
                                },
                                new SelectListItem {
                                    Text = "Đang xử lý",
                                    Value = "Đang xử lý"
                                }
                            }, "Value", "Text", Model.PaymentStatus),
                            "-- Chọn trạng thái --",
                            new { @class = "form-control" })

                        @Html.ValidationMessageFor(
                            model => model.PaymentStatus,
                            "",
                            new { @class = "text-danger" })

                        <p class="order-edit-note">
                            Kiểm tra quy ước trạng thái đang dùng trong dữ liệu của dự án.
                        </p>
                    </div>
                </div>

                <div class="form-group">
                    @Html.LabelFor(
                        model => model.AddressDelivery,
                        "Địa chỉ giao hàng",
                        new { @class = "control-label col-md-3" })

                    <div class="col-md-9">
                        @Html.TextAreaFor(
                            model => model.AddressDelivery,
                            new
                                 {
                                @class = "form-control",
                                rows = "3",
                                placeholder = "Nhập địa chỉ giao hàng"
                            })

                        @Html.ValidationMessageFor(
                            model => model.AddressDelivery,
                            "",
                            new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-3 col-md-9">
                        <div class="order-edit-actions">
                            <button type="submit" class="btn btn-success">
                                <span class="glyphicon glyphicon-floppy-disk"></span>
                                Lưu thay đổi
                            </button>

                            @Html.ActionLink(
                                "Quay lại danh sách",
                                "Index",
                                null,
                                new { @class = "btn btn-default" })

                            @Html.ActionLink(
                                "Xem chi tiết",
                                "Details",
                                new { id = Model.OrderID },
                                new { @class = "btn btn-info" })
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>