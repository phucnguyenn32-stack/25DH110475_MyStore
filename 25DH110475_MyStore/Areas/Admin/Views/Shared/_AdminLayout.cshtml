<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Admin</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>

<body>

    <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
        <div class="container">

            @Html.ActionLink(
                "ADMIN",
                "Index",
                "Home",
                new { area = "Admin" },
                new { @class = "navbar-brand" }
            )

            <div class="navbar-collapse">
                <ul class="navbar-nav">

                    <li class="nav-item">
                        @Html.ActionLink(
                            "Trang chủ",
                            "Index",
                            "Home",
                            new { area = "Admin" },
                            new { @class = "nav-link" }
                        )
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink(
                            "Danh mục",
                            "Index",
                            "Categories",
                            new { area = "Admin" },
                            new { @class = "nav-link" }
                        )
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink(
                            "Sản phẩm",
                            "Index",
                            "Products",
                            new { area = "Admin" },
                            new { @class = "nav-link" }
                        )
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink(
                            "Khách hàng",
                            "Index",
                            "Customers",
                            new { area = "Admin" },
                            new { @class = "nav-link" }
                        )
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink(
                            "Đơn hàng",
                            "Index",
                            "Orders",
                            new { area = "Admin" },
                            new { @class = "nav-link" }
                        )
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink(
                            "Tài khoản",
                            "Index",
                            "Users",
                            new { area = "Admin" },
                            new { @class = "nav-link" }
                        )
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink(
                            "Đăng xuất",
                            "Logout",
                            "Account",
                            new { area = "Admin" },
                            new { @class = "nav-link" }
                        )
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content">

        @RenderBody()

        <hr />

        <footer>
            <p>&copy; @DateTime.Now.Year - Admin</p>
        </footer>

    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

</body>
</html>